{
  "manifest_version": 3,
  "name": "Focus Tracker",
  "version": "1.0.0",
  "description": "Personal focus tracker",
  "permissions": ["alarms", "notifications", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Focus Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  }
}
